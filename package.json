{
  "name": "dotfiles",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "pi-worktree-core",
    "pi-worktree-manager",
    "pi-task",
    "pi-loop-package",
    "pi-claude-bridge",
    "pi-messaging"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs && npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:shell": "shellcheck -x *.sh *.sh.tmpl dot_claude/hooks/*.sh dot_local/bin/*.sh scripts/*.sh",
    "check": "bash scripts/check-repository.sh"
  },
  "overrides": {
    "@earendil-works/pi-ai": "0.82.0",
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@earendil-works/pi-tui": "0.82.0",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.0",
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@earendil-works/pi-tui": "0.82.0",
    "@types/node": "26.1.1",
    "jiti": "2.7.0",
    "typebox": "1.3.8",
    "typescript": "7.0.2"
  }
}
