{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "pi-claude-bridge/extensions/**/*.ts",
    "pi-loop-package/extensions/**/*.ts",
    "pi-task/extensions/**/*.ts",
    "pi-worktree-core/src/**/*.ts",
    "pi-worktree-manager/extensions/**/*.ts",
    "pi-messaging/extensions/**/*.ts",
    "pi-messaging/src/**/*.ts"
  ]
}
