{{- /* chezmoi:modify-template */ -}}
{{- /* The managed zshrc, then what other tools appended (installers add their init blocks), kept
       below a marker. On the first apply (no marker yet), everything after the last occurrence of
       the managed zshrc's final line moves there, as a whole block; lines before it (including
       lines edited in place) are shown in the diff and replaced, never moved.
       Delete kept lines by hand to drop them. */ -}}
{{- $managed := includeTemplate "zshrc" . | trimSuffix "\n" -}}
{{- $marker := "# Added by other tools; chezmoi keeps lines below this marker." -}}
{{- $current := .chezmoi.stdin | replace "\r\n" "\n" -}}
{{- $parts := splitList (printf "\n%s\n" $marker) (printf "\n%s" $current) -}}
{{- $tail := list -}}
{{- if gt (len $parts) 1 -}}
{{-   $tail = splitList "\n" (last $parts) -}}
{{- else -}}
{{-   $anchor := "" -}}
{{-   range splitList "\n" $managed -}}{{- if trim . -}}{{- $anchor = . -}}{{- end -}}{{- end -}}
{{-   $seen := false -}}
{{-   range splitList "\n" $current -}}
{{-     if eq . $anchor -}}{{- $seen = true -}}{{- $tail = list -}}
{{-     else if $seen -}}{{- $tail = append $tail . -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $kept := join "\n" $tail | trimAll "\n" -}}
{{ $managed }}
{{ if $kept }}
{{ $marker }}
{{ $kept }}
{{ end -}}
