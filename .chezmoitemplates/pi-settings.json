{
  "packages": [
    "git:git@github.com:dvdkrv/pi-tools.git@v0.6.3",
    "git:github.com/obra/superpowers@v6.2.0",
    "npm:pi-powerline-footer@0.17.2"
  ],
  "theme": "system",
  "defaultThinkingLevel": "high",
  "defaultTools": ["+tool_search"],
  "powerline": {
    "preset": "default",
    "cache_read": { "format": "percent" },
    "customItems": [
      {
        "id": "messages",
        "statusKey": "pi-messaging",
        "position": "right",
        "color": "accent"
      }
    ]
  }
}
