# Initialize brew PATH (Linuxbrew on workspaces, Homebrew on macOS)
for _prefix in /home/linuxbrew/.linuxbrew /opt/homebrew /usr/local; do
  [[ -x "$_prefix/bin/brew" ]] && eval "$("$_prefix/bin/brew" shellenv)" && break
done
unset _prefix

export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"
if command -v zsh >/dev/null 2>&1; then
  export SHELL="$(command -v zsh)"
fi

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
if [[ -d "$PYENV_ROOT" ]]; then
  export PATH="$PYENV_ROOT/bin:$PATH"
fi
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init - zsh)"
  if command -v pyenv-virtualenv-init >/dev/null 2>&1 || [[ -d "$PYENV_ROOT/plugins/pyenv-virtualenv" ]]; then
    eval "$(pyenv virtualenv-init -)"
  fi
fi

export PIPX_HOME="$HOME/.local/share/pipx"
export PIPX_BIN_DIR="$HOME/.local/bin"
export SUPERPOWERS_DISABLE_TELEMETRY=1

# Stable SSH agent socket for long-running processes.
if [[ -n "${SSH_AUTH_SOCK:-}" && "$SSH_AUTH_SOCK" != "$HOME/.ssh/ssh_auth_sock" ]]; then
  mkdir -p "$HOME/.ssh"
  ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/ssh_auth_sock" 2>/dev/null
fi
if [[ -S "$HOME/.ssh/ssh_auth_sock" || -L "$HOME/.ssh/ssh_auth_sock" ]]; then
  export SSH_AUTH_SOCK="$HOME/.ssh/ssh_auth_sock"
fi

# Export current theme so remote tmux sessions can pick it up via SendEnv.
if [[ -z "${LC_TERMINAL_THEME:-}" ]]; then
  export LC_TERMINAL_THEME="$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/theme" 2>/dev/null || echo dark)"
fi

if [[ -n "${SSH_CONNECTION:-}" ]] && command -v vim >/dev/null 2>&1; then
  export EDITOR="$(command -v vim)"
elif command -v nvim >/dev/null 2>&1; then
  export EDITOR="$(command -v nvim)"
fi

if command -v nvim >/dev/null 2>&1; then
  alias vim=nvim
fi
if [[ -f "$HOME/.claude/hooks/peon-ping/peon.sh" ]]; then
  alias peon='bash ~/.claude/hooks/peon-ping/peon.sh'
fi
[[ -f "$HOME/.claude/hooks/peon-ping/completions.bash" ]] && source "$HOME/.claude/hooks/peon-ping/completions.bash"

if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

BREW_PREFIX=""
if command -v brew >/dev/null 2>&1; then
  BREW_PREFIX="$(brew --prefix)"
fi
_load_zsh_plugin() {
  local name="$1"
  if [[ -n "$BREW_PREFIX" && -f "$BREW_PREFIX/share/$name/$name.zsh" ]]; then
    source "$BREW_PREFIX/share/$name/$name.zsh"
  elif [[ -f "$HOME/.zsh/$name/$name.zsh" ]]; then
    source "$HOME/.zsh/$name/$name.zsh"
  fi
}
_load_zsh_plugin zsh-autosuggestions
_load_zsh_plugin zsh-syntax-highlighting

if [[ -f "$HOME/.zsh/fzf-tab/fzf-tab.plugin.zsh" ]]; then
  autoload -U compinit
  if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
    compinit
  else
    compinit -C
  fi
  source "$HOME/.zsh/fzf-tab/fzf-tab.plugin.zsh"
fi

if command -v zoxide >/dev/null 2>&1; then
  export _ZO_DOCTOR=0
  eval "$(zoxide init zsh)"
  alias cd=z
fi
