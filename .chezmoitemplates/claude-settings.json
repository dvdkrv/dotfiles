{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(date:*)",
      "Bash(file:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(pwd:*)",
      "Bash(rg:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(tree:*)",
      "Bash(git blame:*)",
      "Bash(git diff:*)",
      "Bash(git grep:*)",
      "Bash(git log:*)",
      "Bash(git ls-remote:*)",
      "Bash(git remote show:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh status:*)",
      "Bash(bzl run //:gazelle)",
      "Bash(bzl test:*)",
      "Bash(rapid test:*)",
      "Bash(go test:*)",
      "Bash(go fmt:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(go install:*)",
      "Bash(go mod:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(kubectl api-resources:*)",
      "Bash(kubectl api-versions:*)",
      "Bash(kubectl auth can-i:*)",
      "Bash(kubectl auth whoami:*)",
      "Bash(kubectl cluster-info:*)",
      "Bash(kubectl completion:*)",
      "Bash(kubectl config current-context:*)",
      "Bash(kubectl config get-clusters:*)",
      "Bash(kubectl config get-contexts:*)",
      "Bash(kubectl config get-users:*)",
      "Bash(kubectl config view:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl diff:*)",
      "Bash(kubectl events:*)",
      "Bash(kubectl explain:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl help:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl options:*)",
      "Bash(kubectl top:*)",
      "Bash(kubectl version:*)",
      "Bash(kubectl wait:*)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:platform.openai.com)"
    ]
  },
  "hooks": {
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/ssh-agent-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "commit-commands@claude-code-plugins": true,
    "pyright-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-code-plugins": true,
    "caveman@caveman": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": []
  },
  "alwaysThinkingEnabled": true,
  "skipAutoPermissionPrompt": false,
  "model": "opus",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40"
  }
}
