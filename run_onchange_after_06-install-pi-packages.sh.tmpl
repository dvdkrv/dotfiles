#!/usr/bin/env bash
# Reconcile immutable Pi package releases whenever this script changes.
set -euo pipefail

command -v pi >/dev/null 2>&1 || { echo "pi is required to install Pi packages" >&2; exit 1; }
command -v npm >/dev/null 2>&1 || { echo "npm is required to install Pi package dependencies" >&2; exit 1; }

PI_TOOLS_PACKAGE="git:git@github.com:dvdkrv/pi-tools.git@v0.1.1"
SUPERPOWERS_PACKAGE="git:github.com/obra/superpowers@v6.2.0"
POWERLINE_PACKAGE="npm:pi-powerline-footer@0.17.2"
MARKDOWN_PREVIEW_PACKAGE="npm:pi-markdown-preview@0.18.1"

pi install "$PI_TOOLS_PACKAGE"
pi install "$SUPERPOWERS_PACKAGE"
pi install "$POWERLINE_PACKAGE"
pi install "$MARKDOWN_PREVIEW_PACKAGE"
