#!/usr/bin/env bash
# Install the reviewed Pi Coding Agent version. Update PI_VERSION deliberately.
# Re-runs whenever this script changes (chezmoi onchange).
set -euo pipefail

PI_VERSION="1.0.0"

command -v npm >/dev/null 2>&1 || { echo "npm is required to install Pi" >&2; exit 1; }
npm install -g --ignore-scripts @earendil-works/pi-coding-agent@"$PI_VERSION"
